{
  "name": "@astronexus/dsh-bundle",
  "version": "0.0.0",
  "private": true,
  "description": "AstroNexus 的 DSH bundle 层：插件挂载 + 浏览器主题",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  }
}
